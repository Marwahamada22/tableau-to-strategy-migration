<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2024.1.0' source-platform='win' version='18.1'>
  <preferences />
  <datasources>
    <datasource caption='Sample - Superstore' inline='true' name='federated.0abc123' version='18.1'>
      <connection class='sqlserver' dbname='Superstore' server='sql-server.company.com' username='readonly'>
        <relation name='Orders' table='[dbo].[Orders]' type='table' />
      </connection>
      <!-- Regular dimensions -->
      <column caption='Category' datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column caption='Sub-Category' datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
      <column caption='Region' datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column caption='State' datatype='string' name='[State]' role='dimension' type='nominal' semantic-role='[State].[Name]' />
      <column caption='City' datatype='string' name='[City]' role='dimension' type='nominal' />
      <column caption='Customer Name' datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
      <column caption='Customer ID' datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
      <column caption='Order Date' datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
      <column caption='Ship Date' datatype='date' name='[Ship Date]' role='dimension' type='ordinal' />
      <column caption='Segment' datatype='string' name='[Segment]' role='dimension' type='nominal' />
      <column caption='Ship Mode' datatype='string' name='[Ship Mode]' role='dimension' type='nominal' />
      <!-- Regular measures -->
      <column caption='Sales' datatype='real' name='[Sales]' role='measure' type='quantitative' />
      <column caption='Profit' datatype='real' name='[Profit]' role='measure' type='quantitative' />
      <column caption='Quantity' datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
      <column caption='Discount' datatype='real' name='[Discount]' role='measure' type='quantitative' />
      <!-- Calculated fields -->
      <column caption='Profit Ratio' datatype='real' name='[Calculation_ProfitRatio]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Sales per Customer' datatype='real' name='[Calculation_SalesPerCustomer]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Customer ID])' />
      </column>
      <column caption='YoY Sales Growth' datatype='real' name='[Calculation_YoYGrowth]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Sales])) - LOOKUP(ZN(SUM([Sales])), -1)) / ABS(LOOKUP(ZN(SUM([Sales])), -1))' />
      </column>
      <column caption='Running Total Sales' datatype='real' name='[Calculation_RunningTotal]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))' />
      </column>
      <!-- LOD Expression -->
      <column caption='Customer Total Sales' datatype='real' name='[Calculation_CustomerLOD]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : SUM([Sales]) }' />
      </column>
      <column caption='Category Avg Profit' datatype='real' name='[Calculation_CategoryAvg]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Sub-Category] : AVG([Profit]) }' />
      </column>
      <column caption='Overall Sales (excl Region)' datatype='real' name='[Calculation_ExclRegion]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Region] : SUM([Sales]) }' />
      </column>
      <!-- Conditional calculated column -->
      <column caption='Profit Category' datatype='string' name='[Calculation_ProfitCat]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt; 0 THEN &quot;Profitable&quot; ELSEIF [Profit] = 0 THEN &quot;Break Even&quot; ELSE &quot;Loss&quot; END' />
      </column>
      <column caption='Top Customer Flag' datatype='string' name='[Calculation_TopCust]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [Customer ID] : SUM([Sales]) } &gt; 5000 THEN &quot;Top Customer&quot; ELSE &quot;Regular&quot; END' />
      </column>
    </datasource>
    <!-- Parameters datasource -->
    <datasource caption='Parameters' inline='true' name='Parameters' version='18.1'>
      <column caption='Top N' datatype='integer' name='[Parameter_TopN]' role='measure' type='quantitative' param-domain-type='range'>
        <calculation class='tableau' formula='10' />
        <range max='50' min='5' granularity='5' />
      </column>
      <column caption='Metric Selector' datatype='string' name='[Parameter_Metric]' role='dimension' type='nominal' param-domain-type='list'>
        <calculation class='tableau' formula='&quot;Sales&quot;' />
        <members>
          <member value='&quot;Sales&quot;' />
          <member value='&quot;Profit&quot;' />
          <member value='&quot;Quantity&quot;' />
        </members>
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Sales by Category'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0abc123' />
          </datasources>
          <datasource-dependencies datasource='federated.0abc123'>
            <column name='[Category]' />
            <column name='[Sales]' />
            <column name='[Profit]' />
          </datasource-dependencies>
          <rows>[federated.0abc123].[Category]</rows>
          <cols>[federated.0abc123].[sum:Sales:qk]</cols>
          <mark class='Bar'>
            <encoding attr='color' field='[federated.0abc123].[Category]' type='nominal' />
          </mark>
        </view>
      </table>
    </worksheet>
    <worksheet name='Sales Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0abc123' />
          </datasources>
          <datasource-dependencies datasource='federated.0abc123'>
            <column name='[Order Date]' />
            <column name='[Sales]' />
            <column name='[Category]' />
          </datasource-dependencies>
          <rows>[federated.0abc123].[sum:Sales:qk]</rows>
          <cols>[federated.0abc123].[yr:Order Date:ok]</cols>
          <mark class='Line'>
            <encoding attr='color' field='[federated.0abc123].[Category]' type='nominal' />
          </mark>
        </view>
        <pane>
          <encodings>
            <color column='[federated.0abc123].[Category]' />
            <tooltip column='[federated.0abc123].[Profit]' />
          </encodings>
        </pane>
      </table>
    </worksheet>
    <worksheet name='Profit Map'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0abc123' />
          </datasources>
          <datasource-dependencies datasource='federated.0abc123'>
            <column name='[State]' />
            <column name='[Profit]' />
          </datasource-dependencies>
          <rows>[federated.0abc123].[Latitude (generated)]</rows>
          <cols>[federated.0abc123].[Longitude (generated)]</cols>
          <mark class='Map'>
            <encoding attr='color' field='[federated.0abc123].[sum:Profit:qk]' type='quantitative' />
            <encoding attr='detail' field='[federated.0abc123].[State]' type='nominal' />
          </mark>
        </view>
      </table>
    </worksheet>
    <worksheet name='KPI Summary'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0abc123' />
          </datasources>
          <datasource-dependencies datasource='federated.0abc123'>
            <column name='[Sales]' />
            <column name='[Profit]' />
            <column name='[Quantity]' />
            <column name='[Calculation_ProfitRatio]' />
          </datasource-dependencies>
          <rows></rows>
          <cols>[federated.0abc123].[sum:Sales:qk] [federated.0abc123].[sum:Profit:qk]</cols>
          <mark class='Text' />
        </view>
      </table>
    </worksheet>
    <worksheet name='Detail Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0abc123' />
          </datasources>
          <datasource-dependencies datasource='federated.0abc123'>
            <column name='[Category]' />
            <column name='[Sub-Category]' />
            <column name='[Sales]' />
            <column name='[Profit]' />
            <column name='[Quantity]' />
            <column name='[Calculation_ProfitRatio]' />
          </datasource-dependencies>
          <rows>[federated.0abc123].[Category] [federated.0abc123].[Sub-Category]</rows>
          <cols>[federated.0abc123].[sum:Sales:qk] [federated.0abc123].[sum:Profit:qk] [federated.0abc123].[sum:Quantity:qk]</cols>
          <mark class='Text' />
          <filter class='categorical' column='[federated.0abc123].[Region]'>
            <groupfilter function='member' member='&quot;East&quot;' />
          </filter>
        </view>
        <pane>
          <encodings>
            <text column='[federated.0abc123].[sum:Sales:qk]' />
          </encodings>
        </pane>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Executive Overview'>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='150' name='KPI Summary' type='viz' w='1400' x='0' y='0' />
        <zone h='350' name='Sales Trend' type='viz' w='700' x='0' y='150' />
        <zone h='350' name='Sales by Category' type='viz' w='700' x='700' y='150' />
        <zone h='400' name='Detail Table' type='viz' w='900' x='0' y='500' />
        <zone h='400' name='Profit Map' type='viz' w='500' x='900' y='500' />
        <zone h='30' name='Region Filter' type='filter' w='200' x='0' y='120' />
        <zone h='30' name='Segment Filter' type='filter' w='200' x='200' y='120' />
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='dashboard' name='Executive Overview' />
  </windows>
</workbook>
